# =====================================================================
# Build artifacts
# =====================================================================
node_modules/
dist/
.vite/
src-tauri/target/
src-tauri/gen/
target/
*.tsbuildinfo

# i2pd-bundle/ is regenerated by scripts/bundle-i2pd.sh from the
# Homebrew install. Keeping it out of git keeps the repo small (~11 MB)
# and avoids checking in OS-specific binaries.
src-tauri/i2pd-bundle/

# =====================================================================
# Logs + crash reports
# =====================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# =====================================================================
# OS junk
# =====================================================================
.DS_Store
._*
Thumbs.db
desktop.ini

# =====================================================================
# IDE / editor state — never useful in a shared repo
# =====================================================================
.vscode/
.idea/
.cursor/
.zed/
.fleet/
*.iml
*.swp
*.swo
*.swn
*~
*.orig
*.rej
*.bak

# =====================================================================
# Secrets — defence-in-depth.
# These patterns aren't in the repo today; they exist so a stray
# `git add secrets/` or `git add .env` is a no-op rather than a leak.
# =====================================================================

# Private keys + certificates in any common encoding
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.asc
*.gpg

# SSH key conventions (private only — *.pub is public and OK to commit)
id_rsa
id_ed25519
id_ecdsa
id_dsa

# Env files. .env.example is allowed below so committed templates don't
# get caught by the wildcard.
.env
.env.*
!.env.example

# Common credential directory names
secrets/
credentials/
*.credentials.json

# =====================================================================
# Local SQLCipher / vault artifacts.
# Per-profile databases live under
# `~/Library/Application Support/com.noctisprivacy.whisper/<profile>/`
# (outside the repo) and never enter git. These patterns catch any
# accidental in-repo copy or test-run artifact.
# =====================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
vault_marker

# =====================================================================
# Test / coverage output
# =====================================================================
coverage/
.nyc_output/
*.lcov
