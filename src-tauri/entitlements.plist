<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox.
         DEV NOTE: temporarily disabled while we use the Homebrew i2pd
         binary at /opt/homebrew/opt/i2pd/bin/i2pd. Sandbox forbids
         spawning processes outside the container. Phase 2.5 will
         bundle i2pd into Contents/Resources/ and codesign it, at which
         point this flips back to <true/>. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Hardened Runtime: only what we need -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow inbound TCP listeners — we run the SAM bridge on a
         randomized loopback port and i2pd itself binds for transit
         routing (when opted in). -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!--
        Keychain access. Under ad-hoc signing there is no team-ID prefix, so
        we omit `keychain-access-groups` and let macOS use the default group
        equal to the bundle identifier. For Mac App Store / Developer ID
        builds, add:
            <key>keychain-access-groups</key>
            <array><string>$(AppIdentifierPrefix)com.noctisprivacy.whisper</string></array>
    -->

    <!-- Allow user-selected files for attachment picking -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Hardened runtime guards -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
</dict>
</plist>
