{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper",
  "version": "1.1.0",
  "identifier": "com.noctisprivacy.whisper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Whisper",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "i2pd-bundle/i2pd": "i2pd-bundle/i2pd",
      "i2pd-bundle/lib/*": "i2pd-bundle/lib/",
      "i2pd-bundle/certificates/family/*": "i2pd-bundle/certificates/family/",
      "i2pd-bundle/certificates/reseed/*": "i2pd-bundle/certificates/reseed/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Private post-quantum messenger",
    "longDescription": "Whisper by Noctis Privacy is a privacy-focused desktop messenger with hybrid post-quantum end-to-end encryption, Secure Enclave key protection, and serverless I2P peer-to-peer transport.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "signingIdentity": "Developer ID Application: James Barnett (36636MH6LR)",
      "providerShortName": "36636MH6LR",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}
